# Eduflair — Hostinger Apache (SPA + PHP API + uploads)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never rewrite API or uploads
  RewriteRule ^api/ - [L]
  RewriteRule ^uploads/ - [L]
  RewriteRule ^contact\.php$ - [L]

  # SEO: pre-rendered page per route (generated by src/seo/vite-plugin-seo.js)
  # /german-language.html → 301 → /german-language (one URL per page)
  RewriteCond %{THE_REQUEST} \s/([a-z0-9-]+)\.html[\s?]
  RewriteCond %1 !^index$
  RewriteRule ^ /%1 [R=301,L]
  # /german-language → german-language.html (only if that file exists)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([a-z0-9-]+)/?$ $1.html [L]

  # Keep real files/folders (assets, images, php)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # React Router: all other routes → index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Cache static assets for faster loads
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|jpg|jpeg|png|webp|avif|svg|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
